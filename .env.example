# Copy to `.env` (git-ignored) and adjust. Every variable is optional.

# Neon / PostgreSQL connection string. If unset or empty, the app uses a local SQLite file
# (backend/database/healthrisk.db). Never commit the real value.
# DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Comma-separated list of allowed browser origins for CORS.
# Default: http://localhost:3000,http://127.0.0.1:3000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000